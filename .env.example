# Instagram credentials
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# OpenAI API key – obtain from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-...

# (Optional) OpenAI model to use for response generation (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# (Optional) System prompt that sets the bot's personality / tone
BOT_SYSTEM_PROMPT=You are a friendly and helpful Instagram assistant. Reply concisely and warmly.

# (Optional) Polling interval in seconds between inbox checks (default: 30)
POLL_INTERVAL=30

# (Optional) Maximum number of conversation turns kept in memory per user (default: 10)
MAX_HISTORY=10
